<!-- Animation Engine Scripts (GSAP & Custom Drivers) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
// Initialize GSAP Core Plugins
gsap.registerPlugin(ScrollTrigger);

// Custom Premium Floating Cursor Logic
const cursor = document.getElementById('cursor');
const cursorDot = document.getElementById('cursor-dot');

window.addEventListener('mousemove', (e) => {
    gsap.to(cursor, { x: e.clientX, y: e.clientY, duration: 0.4, ease: 'power3.out' });
    gsap.to(cursorDot, { x: e.clientX, y: e.clientY, duration: 0.1 });
});

// Magnetic & Scale Interactivity Bindings
const interactives = document.querySelectorAll('a, .btn, .bento-card, .project-item, .pill');
interactives.forEach(item => {
    item.addEventListener('mouseenter', () => {
        cursor.classList.add('hovered-state');
        gsap.to(cursor, { scale: 1.2 });
    });
    item.addEventListener('mouseleave', () => {
        cursor.classList.remove('hovered-state');
        gsap.to(cursor, { scale: 1 });
    });
});

// Cinematic Text & Layout Fades Using ScrollTrigger
gsap.from(".hero h1", { opacity: 0, y: 100, duration: 1.2, ease: "power4.out", delay: 0.2 });
gsap.from(".hero-meta", { opacity: 0, y: 50, duration: 1.2, ease: "power3.out", delay: 0.5 });

// Fade in Sections on Scroll automatically
const sections = document.querySelectorAll('section:not(.hero)');
sections.forEach(sec => {
